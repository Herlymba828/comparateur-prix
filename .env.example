# ====================================================
# Configuration Django - Environnement de Production
# ====================================================

# Clé secrète (générer une nouvelle avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY='rv4%-_wqwr+!husgd3zj!oz!_+ia#^#7!#eho!y(%yc=wl)$85'

# Mode débogage (désactiver en production !)
DJANGO_DEBUG=False

# ====================================================
# Configuration des hôtes et sécurité
# ====================================================

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=.up.railway.app,comparo.up.railway.app,127.0.0.1,localhost

# Origines CSRF autorisées (séparées par des virgules)
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://comparo.up.railway.app

# Configuration CORS (Cross-Origin Resource Sharing)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://comparo.up.railway.app,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# URL du site (sans slash final)
SITE_URL=https://comparo.up.railway.app

# URL du frontend (sans slash final)
FRONTEND_URL=https://comparo.up.railway.app

# ====================================================
# Configuration de la base de données
# ====================================================

# Pour la production, utilisez la variable DATABASE_URL fournie par Railway
# Exemple: postgresql://user:password@host:port/dbname?sslmode=require

# Pour le développement local avec PostgreSQL (décommentez et adaptez si nécessaire)
# DB_ENGINE=django.db.backends.postgresql
# POSTGRES_DB=nom_de_votre_base
# POSTGRES_USER=utilisateur
# POSTGRES_PASSWORD=mot_de_passe
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSL_REQUIRE=False  # Mettre à True en production

# Pour le développement avec SQLite (décommentez pour utiliser SQLite en local)
# DATABASE_URL=sqlite:///db.sqlite3

# ====================================================
# Base de données
# ====================================================

# Utilisez DATABASE_URL pour Railway (configuré automatiquement)
# ou définissez manuellement les paramètres ci-dessous :
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_SSL_REQUIRE=True

# Database (PostgreSQL)
# En production: définissez OBLIGATOIREMENT POSTGRES_PASSWORD et envisagez un utilisateur non-superuser
POSTGRES_DB=soutenance2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BlackEurtz8282@
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# En production, activer SSL vers PostgreSQL (si supporté par l'hébergement)
POSTGRES_SSL_REQUIRE=True

# CORS/CSRF (mettre des valeurs plus strictes en production)
# Par défaut, désactiver le "Allow All" et lister des origines explicites
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Auth
USE_JWT_AUTH=true
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# Algorithme de signature JWT
# - RS256 (recommandé en multi-services) avec clés PEM
# - HS256 (clé secrète partagée) si plus simple pour un seul backend
JWT_ALGORITHM=RS256

# RS256: chemins vers les clés PEM (ne pas commiter ces fichiers)
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# HS256 (alternative): définir une clé forte si vous utilisez HS256
# JWT_SIGNING_KEY=

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# ====================================================
# Cache et File d'attente (Redis)
# ==================================================

# URL de connexion Redis (pour le cache et Celery)
REDIS_URL=redis://localhost:6379/0

# Configuration du cache
CACHE_TTL=60 * 15  # 15 minutes

# Configuration Celery (tâches asynchrones)
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_ACCEPT_CONTENT=['json']
CELERY_TASK_SERIALIZER='json'
CELERY_RESULT_SERIALIZER='json'
CELERY_TIMEZONE=Africa/Libreville
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# ====================================================
# Sécurité et Performances
# ==================================================

# Limites de débit (Rate Limiting)
DRF_THROTTLE_ANON=100/min  # Limite pour les utilisateurs anonymes
DRF_THROTTLE_USER=1000/min  # Limite pour les utilisateurs authentifiés

# Protection contre les attaques par force brute
AXES_FAILURE_LIMIT=5  # Nombre d'échecs avant blocage
AXES_COOLOFF_TIME=1  # Durée du blocage en heures
AXES_ONLY_USER_FAILURES=True  # Ne compter que les échecs de connexion utilisateur

# Sécurité des cookies
SESSION_COOKIE_SECURE=True  # En production uniquement
CSRF_COOKIE_SECURE=True  # En production uniquement
SECURE_SSL_REDIRECT=True  # Redirection HTTP vers HTTPS
SECURE_HSTS_SECONDS=31536000  # 1 an
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# ====================================================
# Configuration Frontend/Backend
# ====================================================

# URL du frontend (développement)
FRONTEND_URL=http://localhost:3000

# URL du backend (développement)
BACKEND_URL=http://localhost:8000

# Public base URL for activation links
PUBLIC_BASE_URL=https://comparateurdeprix.com

# ====================================================
# Configuration Email (SMTP)
# ==================================================

