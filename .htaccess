# Configuration .htaccess pour cPanel avec Passenger
# Si Passenger n'est pas disponible, utilisez la configuration alternative ci-dessous

# Configuration Passenger (décommentez si Passenger est disponible)
# PassengerEnabled On
# PassengerAppRoot /home/rs2694021ez6eg8n/public_html/comparer
# PassengerBaseURI /
# PassengerPython /home/rs2694021ez6eg8n/virtualenv/public_html/comparer/3.11/bin/python
# PassengerAppType wsgi
# PassengerStartupFile config/wsgi.py

# Configuration alternative (si Passenger n'est pas disponible)
RewriteEngine On
RewriteBase /

# Rediriger HTTP vers HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Servir les fichiers statiques directement
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/static/
RewriteRule ^static/(.*)$ staticfiles/$1 [L]

# Servir les fichiers médias directement
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/media/
RewriteRule ^media/(.*)$ media/$1 [L]

# Passer toutes les autres requêtes à Django
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.py/$1 [L]

# Sécurité : Empêcher l'accès aux fichiers sensibles
<FilesMatch "^(\.env|\.git|\.htaccess|requirements\.txt|manage\.py)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Headers de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

