# ============================================
# CONFIGURATION DJANGO (OBLIGATOIRE)
# ============================================
# Clé secrète - À générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=votre_clé_secrète_très_longue_et_aléatoire

# Désactiver en production
DJANGO_DEBUG=False

# Hôtes autorisés - Ajoutez vos domaines de production
DJANGO_ALLOWED_HOSTS=.up.railway.app,comparo.up.railway.app,localhost,127.0.0.1

# Configuration CSRF (Cross-Site Request Forgery)
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://comparo.up.railway.app,http://localhost:8000

# Configuration CORS (Cross-Origin Resource Sharing)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://comparo.up.railway.app,http://localhost:3000

# ============================================
# CONFIGURATION DE LA BASE DE DONNÉES
# ============================================
# Pour Railway (recommandé) - Configuré automatiquement
# DATABASE_URL est automatiquement fourni par Railway

# Pour développement local (PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nom_de_votre_base
# DB_USER=utilisateur_postgres
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=localhost
# DB_PORT=5432

# Pour MySQL/MariaDB (si nécessaire)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=nom_de_votre_base
# DB_USER=utilisateur_mysql
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=localhost
# DB_PORT=3306
# DB_OPTIONS={'charset': 'utf8mb4'}
DB_HOST=localhost
DB_PORT=3306

# ============================================
# JWT AUTHENTICATION
# ============================================
USE_JWT_AUTH=true
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7
SITE_URL=https://comparo.up.railway.app
PUBLIC_BASE_URL=https://comparateurdeprix.com

# Algorithme de signature JWT
JWT_ALGORITHM=RS256

# RS256: chemins vers les clés PEM
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# ============================================
# REDIS & CELERY
# ============================================
# Railway: Créez un service Redis, il fournira automatiquement REDIS_URL
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# Pour cPanel/local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# ============================================
# DRF
# ============================================
DRF_THROTTLE_ANON=100/min
DRF_THROTTLE_USER=1000/min

# ============================================
# FRONTEND/BACKEND URLs
# ============================================
FRONTEND_URL=https://comparateurdeprix.com
BACKEND_URL=https://comparo.up.railway.app
PUBLIC_BASE_URL=https://comparateurdeprix.com

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=mail.comparateurdeprix.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@comparateurdeprix.com
EMAIL_HOST_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@comparateurdeprix.com

# ============================================
# SOCIAL AUTHENTICATION
# ============================================
GOOGLE_CLIENT_ID=139484318993-npf1ptnr9ih9k1got5b4fgl3qt3c3mn6.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
